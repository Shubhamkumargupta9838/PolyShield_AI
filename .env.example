# PolyShield AI Environment Configuration
PROJECT_NAME="PolyShield AI"
ENVIRONMENT="development"
DEBUG=true

# API Server Settings
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Authentication & Security Configuration (Phase 13)
AUTH_ENABLED=true
JWT_SECRET_KEY="<insert_strong_random_secret_min_32_bytes_here>"
JWT_ISSUER="polyshield"
JWT_AUDIENCE="polyshield-api"
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=true

# Model Integrity Verification Checksums (Phase 13)
STATIC_MODEL_EXPECTED_SHA256=""
DYNAMIC_MODEL_EXPECTED_SHA256=""

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="polyshield_db"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379/0"

# Celery Asynchronous Workers
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# CAPE Sandbox Integration (Isolated Network Sandbox)
SANDBOX_API_URL="http://localhost:8090/api/v1"
SANDBOX_API_TOKEN="change_this_token_in_production"
SANDBOX_TIMEOUT_SECONDS=300

# Sandbox Security & Isolation Settings (Phase 8 Foundation)
SANDBOX_PROVIDER="mock" # Default MUST be mock (zero host execution)
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_MAX_DISK_MB=20480
SANDBOX_MAX_ARTIFACT_SIZE_MB=500
SANDBOX_INTERNET_ACCESS=false # Default MUST be false
SANDBOX_NETWORK_MODE="isolated"

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB limit
ALLOWED_EXTENSIONS=[".exe",".dll",".sys",".scr",".bin"]

# Model Config
MODEL_VERSION="v1.0.0"
